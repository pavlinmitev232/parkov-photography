# Database
# Local Docker uses the same URL for both variables. Production uses the
# Supabase transaction pooler (6543) at runtime and session pooler (5432)
# for Prisma migrations. Percent-encode special characters in passwords.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/parkov"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5433/parkov"

# Supabase Storage (planned production integration)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_PORTFOLIO_BUCKET="portfolio"
SUPABASE_SITE_ASSETS_BUCKET="site-assets"

# Owner/admin authentication
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
AUTH_SECRET="replace-with-a-secure-secret"

# Inquiry email delivery
INQUIRY_TO_EMAIL="hello@parkov.photo"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# Public contact placeholders
NEXT_PUBLIC_CONTACT_PHONE="+359888000000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@parkov.photo"
