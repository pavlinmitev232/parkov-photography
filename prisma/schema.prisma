generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Inquiry {
  id               String    @id @default(cuid())
  name             String
  email            String
  phone            String
  service          String
  preferredDate    DateTime?
  location         String
  message          String
  preferredContact String?
  status           String    @default("new")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  booking          Booking?
}

model Booking {
  id           String    @id @default(cuid())
  inquiryId    String?   @unique
  customerName String
  email        String
  phone        String
  service      String
  startAt      DateTime
  endAt        DateTime?
  location     String
  notes        String?
  status       String    @default("tentative")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inquiry      Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([status, startAt])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  titleBg     String
  titleEn     String
  category    String
  imageUrl    String
  description String?
  location    String?
  shootYear   Int?
  clientType  String?
  featured    Boolean  @default(false)
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  labelBg   String
  labelEn   String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceItem {
  id        String   @id @default(cuid())
  key       String   @unique
  titleBg   String
  titleEn   String
  copyBg    String
  copyEn    String
  icon      String   @default("camera")
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingPackage {
  id        String   @id @default(cuid())
  key       String   @unique
  titleBg   String
  titleEn   String
  copyBg    String
  copyEn    String
  priceBg   String
  priceEn   String
  featured  Boolean  @default(false)
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  nameBg    String
  nameEn    String
  roleBg    String
  roleEn    String
  quoteBg   String
  quoteEn   String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id         String   @id @default(cuid())
  questionBg String
  questionEn String
  answerBg   String
  answerEn   String
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
